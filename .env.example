# ====================================
# ZERO-KNOWLEDGE PROOF ENVIRONMENT
# ====================================

# GitHub OAuth Configuration
NEXT_PUBLIC_GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Smart Contract Addresses (deployed on Monad)
NEXT_PUBLIC_VERIFIER_ADDRESS=0x...
NEXT_PUBLIC_EVENT_TICKET_ADDRESS=0x...

# Backend API URLs
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ====================================
# EXISTING CONFIGURATION
# ====================================

# MongoDB Connection
DATABASE_URL=mongodb://your-mongo-connection-string

# Authentication Secret
JWT_SECRET=your-super-secure-jwt-secret-key-here

# Stellar Network Configuration
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Existing Contract Addresses
NEXT_PUBLIC_KAIZEN_EVENT_CONTRACT=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ====================================
# SETUP INSTRUCTIONS
# ====================================

# 1. GitHub OAuth App Setup:
#    - Go to: https://github.com/settings/developers
#    - Click "New OAuth App"
#    - Application name: "Your App Name"
#    - Homepage URL: http://localhost:3000
#    - Authorization callback URL: http://localhost:3000/callback/github
#    - Copy Client ID and Client Secret to above variables

# 2. Deploy Smart Contracts:
#    cd contracts
#    npx hardhat run scripts/deploy-zk-tickets.js --network monad-testnet
#    Copy deployed addresses to NEXT_PUBLIC_VERIFIER_ADDRESS and NEXT_PUBLIC_EVENT_TICKET_ADDRESS

# 3. Generate ZK Keys:
#    cd circuits
#    npm install
#    npm run compile
#    npm run setup
#    npm run contribute
#    npm run export-verifier
